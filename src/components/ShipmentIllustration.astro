---
// Flat isometric container-stack illustration, CSS/SVG only — no image libraries.
---

<svg viewBox="0 0 400 460" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Isometric illustration of stacked shipping containers" class="w-full max-w-md mx-auto">
  <ellipse cx="215" cy="435" rx="150" ry="18" fill="#062824" opacity="0.25" />

  <!-- container (0,0) -->
  <polygon points="180,280 250,315 180,350 110,315" fill="#1a9484" stroke="#062824" stroke-width="2" />
  <polygon points="110,315 180,350 180,405 110,370" fill="#062824" stroke="#062824" stroke-width="2" />
  <polygon points="250,315 180,350 180,405 250,370" fill="#0a3d38" stroke="#062824" stroke-width="2" />

  <!-- container (1,0) -->
  <polygon points="250,315 320,350 250,385 180,350" fill="#1a9484" stroke="#062824" stroke-width="2" />
  <polygon points="180,350 250,385 250,440 180,405" fill="#062824" stroke="#062824" stroke-width="2" />
  <polygon points="320,350 250,385 250,440 320,405" fill="#0a3d38" stroke="#062824" stroke-width="2" />

  <!-- container (0,1) -->
  <polygon points="180,225 250,260 180,295 110,260" fill="#1a9484" stroke="#062824" stroke-width="2" />
  <polygon points="110,260 180,295 180,350 110,315" fill="#062824" stroke="#062824" stroke-width="2" />
  <polygon points="250,260 180,295 180,350 250,315" fill="#0a3d38" stroke="#062824" stroke-width="2" />

  <!-- container (1,1) — amber accent -->
  <polygon points="250,260 320,295 250,330 180,295" fill="#e4b567" stroke="#062824" stroke-width="2" />
  <polygon points="180,295 250,330 250,385 180,350" fill="#a86f1f" stroke="#062824" stroke-width="2" />
  <polygon points="320,295 250,330 250,385 320,350" fill="#c48a2e" stroke="#062824" stroke-width="2" />

  <!-- corrugation accents on the amber container -->
  <g stroke="#062824" stroke-width="1.5" opacity="0.35">
    <line x1="195" y1="303" x2="195" y2="358" />
    <line x1="215" y1="313" x2="215" y2="368" />
    <line x1="235" y1="323" x2="235" y2="378" />
  </g>
</svg>
