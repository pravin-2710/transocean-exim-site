---
const year = new Date().getFullYear();

const links = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="border-t-2 border-amber-500 bg-teal-900 text-sand-100">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
    <p class="text-sm font-semibold tracking-tight text-white">Transocean Exim Solutions</p>

    <nav class="flex flex-wrap gap-x-6 gap-y-2">
      {
        links.map((link) => (
          <a href={link.href} class="text-sm text-sand-200/80 transition-colors hover:text-amber-400">
            {link.label}
          </a>
        ))
      }
    </nav>

    <p class="text-xs text-sand-200/60">&copy; {year} Transocean Exim Solutions. All rights reserved.</p>
  </div>
</footer>
