---
interface SpecRow {
  label: string;
  value: string;
}

interface Props {
  rows: SpecRow[];
}

const { rows } = Astro.props;
---

<table class="w-full border-collapse text-sm">
  <tbody>
    {
      rows.map((row) => (
        <tr class="border-b border-teal-900/10 last:border-none">
          <th scope="row" class="w-2/5 py-2 pr-4 text-left font-medium text-navy-700/70">
            {row.label}
          </th>
          <td class="py-2 text-navy-900">{row.value}</td>
        </tr>
      ))
    }
  </tbody>
</table>
