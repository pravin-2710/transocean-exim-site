---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecTable from '../../components/SpecTable.astro';
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { name, weight, shelfLife, packingType, nutsPerBag, fclQuantity, image } = product.data;

const rows = [
  { label: 'Weight', value: weight },
  { label: 'Shelf life', value: shelfLife },
  { label: 'Packing type', value: packingType },
  { label: 'Nuts per bag', value: String(nutsPerBag) },
  { label: 'FCL quantity', value: fclQuantity },
];
---

<BaseLayout title={name}>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
    <a href="/products" class="text-sm font-medium text-navy-700/70 transition-colors hover:text-amber-500">&larr; All products</a>

    <div class="mt-6 grid grid-cols-1 gap-10 md:grid-cols-2">
      <Image src={image} alt={name} width={640} height={480} class="w-full rounded-lg border border-teal-900/10 object-cover" />

      <div>
        <h1 class="text-3xl font-semibold tracking-tight text-navy-900">{name}</h1>
        <div class="mt-6">
          <SpecTable rows={rows} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
