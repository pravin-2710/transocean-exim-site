---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ShipmentIllustration from '../components/ShipmentIllustration.astro';
import CategoryTile from '../components/CategoryTile.astro';

import semiHuskedTile from '../assets/products/semi-husked-coconut-tile.jpg';
import coconutCopraTile from '../assets/products/coconut-copra-tile.jpg';
import tenderCoconutTile from '../assets/products/tender-coconut-tile.png';

import apedaLogo from '../assets/certifications/apeda.png';
import fssaiLogo from '../assets/certifications/fssai.jpg';
import dgftLogo from '../assets/certifications/dgft.jpg';
import cdbLogo from '../assets/certifications/coconut-development-board.jpg';

import qualityCheckPhoto from '../assets/trust/quality-check.jpg';

const categories = [
  {
    title: 'Semi Husked Coconut',
    href: '/products/semi-husked-coconut',
    image: semiHuskedTile,
    imageAlt: 'Semi husked coconuts with the fibrous husk partially removed',
  },
  {
    title: 'Coconut Copra',
    href: '/products/coconut-copra',
    image: coconutCopraTile,
    imageAlt: 'Dried coconut copra shells split open, showing the white kernel',
  },
  {
    title: 'Tender Coconut',
    href: '/products/tender-coconut',
    image: tenderCoconutTile,
    imageAlt: 'Freshly harvested tender coconuts stacked in bulk',
  },
];

const certifications = [
  { name: 'Coconut Development Board', logo: cdbLogo },
  { name: 'APEDA', logo: apedaLogo },
  { name: 'FSSAI', logo: fssaiLogo },
  { name: 'DGFT Registered', logo: dgftLogo },
];
---

<BaseLayout title="Home">
  <Hero
    eyebrow="Bringing India's Finest to the World"
    title="Bridging Borders, Building Opportunities"
    subtitle="Transocean Exim Solutions exports coconut products from India to buyers worldwide."
    primaryCta={{ text: 'View Products', href: '/products' }}
    secondaryCta={{ text: 'Request a Quote', href: '/contact' }}
  >
    <ShipmentIllustration slot="illustration" />
  </Hero>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-amber-500">Our Products</p>
    <h2 class="mt-2 text-2xl font-semibold tracking-tight text-navy-900 sm:text-3xl">Product Categories</h2>

    <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map((category) => <CategoryTile {...category} />)}
    </div>
  </section>

  <section class="border-y border-teal-900/10 bg-teal-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-widest text-amber-500">Certifications</p>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        {
          certifications.map((cert) => (
            <div class="flex h-20 items-center rounded-lg border border-teal-900/10 bg-white px-5 shadow-sm">
              <Image src={cert.logo} alt={cert.name} height={64} class="h-16 w-auto object-contain" />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <p class="text-sm font-semibold uppercase tracking-widest text-amber-500">Why Transocean Exim</p>
    <div class="mt-4 grid grid-cols-1 gap-8 md:grid-cols-2">
      <Image
        src={qualityCheckPhoto}
        alt="Coconut being weighed on a digital scale during quality checks"
        width={640}
        height={480}
        class="w-full rounded-lg border border-teal-900/10 object-cover"
      />

      <div>
        <p class="text-4xl font-semibold tracking-tight text-navy-900">[X years]</p>
        <p class="mt-1 text-sm text-navy-700/70">in coconut export</p>
        <p class="mt-4 text-navy-700/70">
          [Brief description of what Transocean Exim Solutions does — to be confirmed before this goes live.]
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
